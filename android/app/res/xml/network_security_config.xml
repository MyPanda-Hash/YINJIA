<?xml version="1.0" encoding="utf-8"?>
<!-- 工厂内网是 http://IP:8090(无证书),必须显式允许明文,否则 WebView 直接拒绝加载 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
