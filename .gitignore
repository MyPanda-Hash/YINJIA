/deploy/incr-prod-pick-outh-*/tools/
/deploy/incr-prod-pick-outh-*/static/
/deploy/incr-prod-pick-outh-*/verify/
/deploy/incr-prod-pick-outh-*/SHA256SUMS.txt
/deploy/incr-prod-pick-outh-*/logs/
/deploy/incr-prod-pick-outh-*.zip
