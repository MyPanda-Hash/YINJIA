# YINJIA-MES .gitignore
node_modules/
dist/
target/
*.jar
*.rar
*.tar.gz
*.log
# 根目录日志/诊断文本:原先只 ignore 了 *.log,logs-*.txt 这类漏网(2026-09-21 实测
# git check-ignore 对 logs-8090-appjar.txt 不命中,属"随时可能被误提交"状态)。
# 诊断产物一律别放仓库根目录:写 $env:TEMP,或按规范放 tools/archive/_*。
logs-*.txt
logs*.txt
# 运行日志目录:后端 logback 写 backend/logs(含滚动 .gz),会话/构建留痕写根 logs/。
# 都是运行时产物,不入库;要留证据请按规范放 tools/archive/_*(2026-10-19 审查增)。
/logs/
/backend/logs/
# harness(DSH)视觉工具的产物目录:截图/标注落在工作区根目录,属工具缓存,不入库(2026-09-22 实测出现)
.dsh-tool-vision/
.env
.env.local
*.local
.vite/
.vite-temp/
.DS_Store
Thumbs.db
收集客户资料/

# 参照用数据库备份目录(45MB .bak,目录名即约定:不入库、不上传)
参照数据库（不上传仓库）/
*.bak

# 参照用文档目录(客户资料 xlsx 等,目录名即约定:不入库、不上传)
# 注:目录名是「参考文档」而非「参照数据库」,原先只有上面那条规则 → 该目录一直未被忽略,
#     git add -A 会把客户品质资料带进仓库。此处按同一约定补上。
参考文档（不上传仓库）/

# 参照资料统一父目录(2026-09-23:上述两目录被挪进 参考（不上传仓库）/ 下,内含 参考调研需求 等资料;
# 同一约定:不入库、不上传 —— 直接忽略整个父目录,免得内部再改名又漏)
参考（不上传仓库）/

# 本地缓存与工具链(体积大,不入库)
.m2-repo/
.npm-cache/
tools/apache-maven-3.9.9/
tools/jdk-17/

# 本地 e2e 测试工作区(选型未定,不入库)
tests/

# 例外:数据库同步工具需要的 JDBC 驱动
!tools/lib/mssql-jdbc.jar
# 安卓扫码用的 ZXing core(593 KB,离线构建必需;与 mssql-jdbc 同一先例)
!android/libs/*.jar
!android-cap/android/app/libs/*.jar

# 误创建的 Maven 本地仓库(settings.xml 的 localRepository 未展开环境变量)
# 无前导斜杠=任意层级匹配(含仓库根);原 */ 前缀只匹配子目录,根级漏网
${env.YINJIA_M2_REPO}/

# 会话诊断脚本与临时产物:tools 根层不再堆放(历史产物已归档 tools/archive/ 并入库);
# 根层规则保留作防线,防止再往根层丢。新的一次性探针/任务产物直接写 tools/archive/ 并入库。
tools/_*.cjs
tools/_*.json
tools/_*.md
tools/_*.txt
tools/vc-out.txt
tools/vd-out.txt
tools/_void-check.sql
tools/archive/_walk/_rsc*.cjs
tools/archive/_walk/*.generated.js
# tools/verify/ 入库的是可复跑探针(无下划线命名);带下划线的是会话残留
# (截图 _*.png、上下文转储 _*.txt、一次性调试脚本 _*.cjs、备份 _*.tsv),不入库
tools/verify/_*

deploy/*.bak
deploy/*.jar
# 凭证配置(金蝶 clientId/Secret + 数据库口令,绝不入库;模板见 config.example.json)
deploy/config.json
deploy/state.json
deploy/logs/
deploy/backup/
deploy/sync.lock
# make-deploy-package.ps1 产出的部署包(含 app.jar 与 .bak,不入库)
deploy/pkg-*/
# 增量工具更新包(如金蝶拉取同步器脚本包;2026-10-07 增,内容与 deploy/ 根同源,无需入库)
deploy/jdy-sync-update-*/
*.deploy.zip
yinjia-mes-deploy.zip

tools/archive/_flow-v12/forms-images-full/
tools/archive/_flow-v12/_runsql-out.txt
tools/archive/_flow-v12/_grant-out.txt

# 本地 IDE 配置(不入库)
.vscode/
.idea/

# 本地整机备份目录(不入库)
_local-backup-*/

# 本地测试脚本目录(不入库、不上传)
tests/
deploy/config-push.json
deploy/push/push-state.json

# 转ERP真实账套凭证(push/config.json)+测试沙箱打包目录(含凭证,绝不入库)
deploy/push/config.json
deploy/push/config.test.json
temp-push-sandbox/

# 单文件传输包(部署用,含 app.jar/.bak,不入库)
deploy/*.zip

# JDK 安装包(服务器部署前置件,110MB 二进制,绝不入库;2026-09-21 增)
deploy/*.msi
*.msi

# 会话导出包(AI 工具产物,勿入库)
dsh-session-*/
.zcodeignore

# esbuild 临时目录(前端构建产物,勿入库)
.esbuild-tmp/

# 前端构建临时目录(勿入库)
frontend/.build-tmp/

# ── 截图一律不入库(用户口径 2026-10-15)──────────────────────────────
# 「截图不要入库,截图不上传,本地的截图不上传上去」——CDP 探针实拍、页面导出图等
# 一律只留本地作证据,不提交、不推送。
# ⚠ 历史上已入库的 png 保持原样(已跟踪文件不受本规则影响,不会被动删);
#   将来确有需要入库的图,显式 `git add -f <路径>` 并在提交信息里说明理由。
*.png
# 探针产出的 PDF / Excel 同理(打印与报表管线的取证产物,如
# _probe-first-insp-export.mjs --printpdf、_probe-first-insp-report.mjs --xlsx):
# 只留本地作证据,不入库。真正要交付的文件请显式 `git add -f`。
_*.pdf
_*.xlsx

# ── javac 落在仓库里的 .class 一律不入库(2026-10-17 审查增)────────────
# `java -cp tools/lib/mssql-jdbc.jar tools/xxx.java` 这类单文件源码启动会在**源码旁边**留下 .class
# (实测一次审查就攒出 tools/_PdfText.class、tools/archive/_q.class、_q_manu_order_state_probe.class)。
# 它们是编译产物、不是证据:证据是 .out/.txt(本仓库已入库几百个,继续照旧)。
# ⚠ tools/archive/_insp-report/_classes/*.class 是**故意入库**的探针产出(已跟踪,不受本规则影响)。
*.class

# ── 根目录 .tmp/ 不入库(2026-10-17 审查增,实测 619MB / 8362 个文件)──────
# 这是**运行时与工具**的临时目录,不是仓库内容:tomcat-docbase.8090.*(8090 服务的
# Tomcat 解包目录)、hsperfdata_*(JVM 性能数据)、node-compile-cache、msedge/Importer
# 解包残留、以及会话调试脚本(如 head_*.java)。原先**没有任何规则覆盖它** ——
# `git add -A` 会把 619MB 全扫进来(实测 `git check-ignore -v .tmp/cp.txt` 退出码 1 = 未忽略)。
.tmp/
# ── 安卓壳(2026-10-20):构建产物不入库;keystore 入库(内部自签名,丢了就得全体卸载重装) ──
android/build/
android/dist/
# 安卓壳:前端产物在构建时从 frontend/dist 拷进 assets/www(每次 build.ps1 重新生成),
# 属于构建产物,不入库(仓库里已有 frontend/dist 与 backend/static 两份,不再存第三份)。
android/app/assets/
# ── 安卓 Capacitor 工程(2026-10-20):依赖/构建产物/本地下发的工具链都不入库 ──
android-cap/node_modules/
android-cap/dist/
android-cap/.tmp/
android-cap/.gradle-home/
android-cap/.gradle-dist/
android-cap/.jdk21/
android-cap/android/.gradle/
android-cap/android/.idea/
android-cap/android/build/
android-cap/android/app/build/
android-cap/android/local.properties
# cap copy 每次从 frontend/dist 生成,属构建产物(与手搓版的 assets/www 同理)
android-cap/android/app/src/main/assets/public/
android-cap/android/app/src/main/assets/capacitor.config.json
# 逆向用的一次性 APK 原件(28MB,用户给的参考包)不入库,只留分析脚本与结论
tools/archive/_apk-probe-20261020/*.apk
tools/archive/_apk-probe-20261020/ref-classes.dex
# 负库存配平脚本的输出(计划/备份快照里含真实业务数据,不入库)
tools/_balance-out/
tools/_out/

