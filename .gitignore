/deploy/incr-wo-mixing-*/tools/
/deploy/incr-wo-mixing-*/static/
/deploy/incr-wo-mixing-*/verify/
/deploy/incr-wo-mixing-*/SHA256SUMS.txt
/deploy/incr-wo-mixing-*/logs/
/deploy/incr-wo-mixing-*.zip
