<?xml version="1.0" encoding="UTF-8"?>
<!--
  制程检验记录表报表模板(QC_PROC_INSP / qc_proc_insp_head + qc_proc_insp_detail,2026-10-17 **纵向表版**)
  ============================================================================
  用户 2026-10-17 口径:
    「好的当前制程检验形式错误了,这个内容进行修改实现……不需要那些外观什么的」
    「等下,表头内容可以不进行修改,当前针对检验结果处的格式进行修改即可」
    「当前这个报表形式需要根据当前页面修改实现导出,形成和当前页面导出形式相同的 excel 形式
      而不是当前的旧报表形式」
  ⇒ 本模板与**面板纸张表(QcProcInspSheet.vue)同一版式**:
      公司 + 标题 → 抬头(单据要素,每行 2 组「标签|值」)
      → 表头两行:客户名称|产品编码|型号（mm）|批号|**检验人员：<值>**(跨 检验要求+检验方法)|产线常规功能性结果|结果判断
                   检验要求 | 检验方法
      → 明细:一行一个检验项目(检验要求/检验方法/产线常规功能性结果/结果判断;长文本 StretchHeight 自动长高)
      → 结论区:检验结论 / 处理意见 ; 页脚:检验员/审核/批准 + 页码 + 打印时间
  旧版式(外观/尺寸/出货重量 三组矩阵 + 尺寸_1..5/重量_1..5 定格参数)**已废弃** ——
  随之 ReportService 里那套「按表区归并/摊平成定格」的参数也不再产出(见该文件同批清理)。

  ⚠ 数据契约(ReportService):
    · $P{...} = 头字段标量 headParams 按 yj_field.label 下发 + 单据编号/打印时间后端补;
    · $F{...} = 明细行(detailRows),字段名 = yj_field.label —— 纵向表里明细**全部行**都进 detail,
      不再挑「表区=功能性测试」那一拨。
  ⚠ JR 6.x XSD 排版坑(与 so_order/sl_recv 同套):
    · 样式集中声明;<box><pen/></box> 写法;band 必须包在分节元素里;
    · textAlignment/verticalAlignment 只作 textElement 属性;**长文本自动长高用 textAdjust="StretchHeight"**
      (isStretchWithOverflow 已废弃);
    · JR 的 reportElement x/y/width/height **只能是整数常量** ⇒ 列宽按 758pt 手工切好(见下方列宽注释)。
  ⚠ band 顺序(严格):title → pageHeader → columnHeader → detail → columnFooter → pageFooter → lastPageFooter → summary → noData
-->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="qc_proc_insp" language="java" columnCount="1"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="758" leftMargin="42" rightMargin="42" topMargin="30" bottomMargin="30"
              whenNoDataType="AllSectionsNoDetail"
              uuid="a7f3c1d8-52e9-4b06-9c14-8d2f6a0b7e32">

  <property name="net.sf.jasperreports.awt.ignore.missing.font" value="false"/>
  <property name="net.sf.jasperreports.default.font.name" value="NotoSansSC"/>
  <property name="net.sf.jasperreports.export.xlsx.detect.cell.type" value="true"/>

  <!-- ======================= 样式(与 so_order / sl_recv 同套) ======================= -->
  <style name="base" isDefault="true" fontName="NotoSansSC" fontSize="9"/>
  <style name="cell" style="base" hAlign="Left" vAlign="Middle">
    <box padding="2">
      <pen lineWidth="0.5" lineColor="#8A8A8A"/>
    </box>
  </style>
  <style name="cellC" style="cell" hAlign="Center"/>
  <style name="th" style="cell" isBold="true" hAlign="Center" mode="Opaque" backcolor="#EFEFEF"/>
  <style name="bandTitle" style="base" fontSize="11" isBold="true" hAlign="Center" vAlign="Middle"
         mode="Opaque" backcolor="#DCE6F1">
    <box padding="2">
      <pen lineWidth="0.5" lineColor="#8A8A8A"/>
    </box>
  </style>
  <style name="company" style="base" fontSize="16" isBold="true" hAlign="Center" vAlign="Bottom"/>
  <style name="docTitle" style="base" fontSize="15" isBold="true" hAlign="Center" vAlign="Middle"/>
  <style name="meta" style="base" fontSize="9" vAlign="Middle"/>
  <style name="pager" style="base" vAlign="Middle"/>
  <style name="pagerR" style="pager" hAlign="Right"/>
  <style name="sign" style="base" fontSize="9" vAlign="Middle"/>
  <style name="blank" style="base">
    <box padding="0">
      <pen lineWidth="0.5" lineColor="#8A8A8A"/>
    </box>
  </style>

  <!-- 小字号单元格(表头/数据行用;字体大小必须在 style 里,不能写在 reportElement 上) -->
  <style name="th7" style="th" fontSize="7"/>
  <style name="th8" style="th" fontSize="8"/>
  <style name="c7" style="cellC" fontSize="7"/>
  <style name="c8" style="cellC" fontSize="8"/>
  <style name="l7" style="cell" fontSize="7"/>
  <style name="l8" style="cell" fontSize="8"/>
  <style name="lb8" style="cell" fontSize="8" isBold="true" hAlign="Center" mode="Opaque" backcolor="#DCE6F1"/>

  <!-- ======================= 参数(头字段) ======================= -->
  <parameter name="单据编号" class="java.lang.String" isForPrompting="false"/>
  <parameter name="单据日期" class="java.util.Date" isForPrompting="false"/>
  <parameter name="单据状态" class="java.lang.String" isForPrompting="false"/>
  <parameter name="检验类别" class="java.lang.String" isForPrompting="false"/>
  <parameter name="工单号" class="java.lang.String" isForPrompting="false"/>
  <parameter name="工序" class="java.lang.String" isForPrompting="false"/>
  <parameter name="批次号" class="java.lang.String" isForPrompting="false"/>
  <parameter name="客户名称" class="java.lang.String" isForPrompting="false"/>
  <parameter name="产品编码" class="java.lang.String" isForPrompting="false"/>
  <parameter name="产品名称" class="java.lang.String" isForPrompting="false"/>
  <parameter name="规格型号" class="java.lang.String" isForPrompting="false"/>
  <parameter name="抽检总量" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="检验员" class="java.lang.String" isForPrompting="false"/>
  <parameter name="检验日期" class="java.util.Date" isForPrompting="false"/>
  <parameter name="检验方案" class="java.lang.String" isForPrompting="false"/>
  <parameter name="总结论" class="java.lang.String" isForPrompting="false"/>
  <parameter name="处理方式" class="java.lang.String" isForPrompting="false"/>
  <parameter name="审核人" class="java.lang.String" isForPrompting="false"/>
  <parameter name="打印时间" class="java.lang.String" isForPrompting="false"/>
  <parameter name="公司名称" class="java.lang.String" isForPrompting="false">
    <defaultValueExpression><![CDATA["惠州市银嘉环保科技有限公司"]]></defaultValueExpression>
  </parameter>

  <!-- ======================= 字段(明细行) ======================= -->
  <field name="行号" class="java.lang.Integer"/>
  <field name="表区" class="java.lang.String"/>
  <field name="检验项目" class="java.lang.String"/>
  <field name="检验要求" class="java.lang.String"/>
  <field name="检验方法" class="java.lang.String"/>
  <field name="产线常规功能性结果" class="java.lang.String"/>
  <field name="结果判断" class="java.lang.String"/>

  <!--
    列宽(合计 758pt = columnWidth;照面板纸张表比例切):
      客户名称 110 | 产品编码 90 | 型号（mm） 88 | 批号 88 | 检验要求 150 | 检验方法 150 | 产线常规功能性结果 40 | 结果判断 42
    ⇒ x 坐标:0 / 110 / 200 / 288 / 376 / 526 / 676 / 716 / 758
  -->

  <!-- ======================= 标题 + 抬头(band: title) ======================= -->
  <title>
    <band height="126">
      <!-- ⚠ band 高度必须盖住里面所有元素(块底 = y+height);少 2pt 就会报
           "Element bottom reaches outside band area" 而编译失败 -->
      <textField>
        <reportElement style="company" x="0" y="0" width="758" height="20"/>
        <textFieldExpression><![CDATA[$P{公司名称}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="docTitle" x="0" y="20" width="758" height="20"/>
        <textFieldExpression><![CDATA["制程检验记录表"]]></textFieldExpression>
      </textField>

      <!-- 抬头:5 行 × 2 组「标签|值」(与面板纸张表同序) -->
      <!-- 第 1 行 -->
      <staticText><reportElement style="lb8" x="0" y="42" width="60" height="14"/><text><![CDATA[单据编号]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="60" y="42" width="150" height="14"/><textFieldExpression><![CDATA[$P{单据编号}]]></textFieldExpression></textField>
      <staticText><reportElement style="lb8" x="379" y="42" width="60" height="14"/><text><![CDATA[单据日期]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="439" y="42" width="150" height="14"/><textFieldExpression><![CDATA[$P{单据日期} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.CHINA).format($P{单据日期})]]></textFieldExpression></textField>
      <!-- 第 2 行 -->
      <staticText><reportElement style="lb8" x="0" y="56" width="60" height="14"/><text><![CDATA[检验类别]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="60" y="56" width="150" height="14"/><textFieldExpression><![CDATA[$P{检验类别}]]></textFieldExpression></textField>
      <staticText><reportElement style="lb8" x="379" y="56" width="60" height="14"/><text><![CDATA[工单号]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="439" y="56" width="150" height="14"/><textFieldExpression><![CDATA[$P{工单号}]]></textFieldExpression></textField>
      <!-- 第 3 行 -->
      <staticText><reportElement style="lb8" x="0" y="70" width="60" height="14"/><text><![CDATA[工序]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="60" y="70" width="150" height="14"/><textFieldExpression><![CDATA[$P{工序}]]></textFieldExpression></textField>
      <staticText><reportElement style="lb8" x="379" y="70" width="60" height="14"/><text><![CDATA[产品名称]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="439" y="70" width="150" height="14"/><textFieldExpression><![CDATA[$P{产品名称}]]></textFieldExpression></textField>
      <!-- 第 4 行 -->
      <staticText><reportElement style="lb8" x="0" y="84" width="60" height="14"/><text><![CDATA[抽检总量]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="60" y="84" width="150" height="14"/><textFieldExpression><![CDATA[$P{抽检总量}]]></textFieldExpression></textField>
      <staticText><reportElement style="lb8" x="379" y="84" width="60" height="14"/><text><![CDATA[检验日期]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="439" y="84" width="150" height="14"/><textFieldExpression><![CDATA[$P{检验日期} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.CHINA).format($P{检验日期})]]></textFieldExpression></textField>
      <!-- 第 5 行 -->
      <staticText><reportElement style="lb8" x="0" y="98" width="60" height="14"/><text><![CDATA[检验方案]]></text></staticText>
      <textField isBlankWhenNull="true" textAdjust="StretchHeight"><reportElement style="l8" x="60" y="98" width="529" height="14"/><textFieldExpression><![CDATA[$P{检验方案}]]></textFieldExpression></textField>

      <!-- 分区带「检验结果」(与面板一致的蓝底条) -->
      <staticText><reportElement style="bandTitle" x="0" y="114" width="758" height="12"/><text><![CDATA[检验结果]]></text></staticText>
    </band>
  </title>

  <pageHeader>
    <band height="1"/>
  </pageHeader>

  <!-- ======================= 表头两行(band: columnHeader,每页重复) ======================= -->
  <columnHeader>
    <band height="28">
      <!-- 左四列:跨两行(高 28) -->
      <staticText><reportElement style="th7" x="0" y="0" width="110" height="28"/><text><![CDATA[客户名称]]></text></staticText>
      <staticText><reportElement style="th7" x="110" y="0" width="90" height="28"/><text><![CDATA[产品编码]]></text></staticText>
      <staticText><reportElement style="th7" x="200" y="0" width="88" height="28"/><text><![CDATA[型号（mm）]]></text></staticText>
      <staticText><reportElement style="th7" x="288" y="0" width="88" height="28"/><text><![CDATA[批号]]></text></staticText>
      <!-- 右侧两列:跨两行(高 28) -->
      <staticText><reportElement style="th7" x="676" y="0" width="40" height="28"/><text><![CDATA[产线常规功能性结果]]></text></staticText>
      <staticText><reportElement style="th7" x="716" y="0" width="42" height="28"/><text><![CDATA[结果判断]]></text></staticText>
      <!-- 检验人员:跨「检验要求 + 检验方法」两列,占第一行 -->
      <staticText><reportElement style="th8" x="376" y="0" width="90" height="14"/><text><![CDATA[检验人员：]]></text></staticText>
      <textField isBlankWhenNull="true"><reportElement style="l8" x="466" y="0" width="210" height="14"/><textFieldExpression><![CDATA[$P{检验员}]]></textFieldExpression></textField>
      <!-- 第二行:两个字段名 -->
      <staticText><reportElement style="th8" x="376" y="14" width="150" height="14"/><text><![CDATA[检验要求]]></text></staticText>
      <staticText><reportElement style="th8" x="526" y="14" width="150" height="14"/><text><![CDATA[检验方法]]></text></staticText>
    </band>
  </columnHeader>

  <!-- ======================= 明细:一行一个检验项目(band: detail) =======================
       左四列是**单据级**值:只在第 1 行渲染(与面板纸张表"纵向合并"同一观感);
       长文本(检验要求/检验方法)用 textAdjust="StretchHeight" —— 内容多高、这一行就多高。 -->
  <detail>
    <band height="16">
      <!-- ⚠ printWhenExpression 是 <reportElement> 的**子元素**,不是 <textField> 的属性
           (写成属性会报 cvc-complex-type.3.2.2;照 report-generic.jrxml 的既有写法) -->
      <textField isBlankWhenNull="true">
        <reportElement style="l7" x="0" y="0" width="110" height="16">
          <printWhenExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() == 1)]]></printWhenExpression>
        </reportElement>
        <textFieldExpression><![CDATA[$P{客户名称}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c7" x="110" y="0" width="90" height="16">
          <printWhenExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() == 1)]]></printWhenExpression>
        </reportElement>
        <textFieldExpression><![CDATA[$P{产品编码}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c7" x="200" y="0" width="88" height="16">
          <printWhenExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() == 1)]]></printWhenExpression>
        </reportElement>
        <textFieldExpression><![CDATA[$P{规格型号}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c7" x="288" y="0" width="88" height="16">
          <printWhenExpression><![CDATA[new Boolean($V{REPORT_COUNT}.intValue() == 1)]]></printWhenExpression>
        </reportElement>
        <textFieldExpression><![CDATA[$P{批次号}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true" textAdjust="StretchHeight">
        <reportElement style="l7" x="376" y="0" width="150" height="16"/>
        <textFieldExpression><![CDATA[$F{检验要求}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true" textAdjust="StretchHeight">
        <reportElement style="l7" x="526" y="0" width="150" height="16"/>
        <textFieldExpression><![CDATA[$F{检验方法}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c7" x="676" y="0" width="40" height="16"/>
        <textFieldExpression><![CDATA[$F{产线常规功能性结果}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c7" x="716" y="0" width="42" height="16"/>
        <textFieldExpression><![CDATA[$F{结果判断}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <!-- ======================= 页脚:页码 / 打印时间 / 签署 ======================= -->
  <pageFooter>
    <band height="30">
      <textField>
        <reportElement style="pager" x="0" y="0" width="200" height="12"/>
        <textFieldExpression><![CDATA["第 " + $V{PAGE_NUMBER} + " 页"]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="pagerR" x="558" y="0" width="200" height="12"/>
        <textFieldExpression><![CDATA["打印时间：" + $P{打印时间}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement style="sign" x="0" y="14" width="60" height="14"/>
        <text><![CDATA[检验员：]]></text>
      </staticText>
      <textField isBlankWhenNull="true">
        <reportElement style="sign" x="60" y="14" width="130" height="14"/>
        <textFieldExpression><![CDATA[$P{检验员}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement style="sign" x="260" y="14" width="50" height="14"/>
        <text><![CDATA[审核：]]></text>
      </staticText>
      <textField isBlankWhenNull="true">
        <reportElement style="sign" x="310" y="14" width="130" height="14"/>
        <textFieldExpression><![CDATA[$P{审核人}]]></textFieldExpression>
      </textField>
      <staticText>
        <reportElement style="sign" x="500" y="14" width="50" height="14"/>
        <text><![CDATA[批准：]]></text>
      </staticText>
    </band>
  </pageFooter>

  <!-- ======================= 结论区(band: summary) =======================
       ⚠ 顺序是**严格的**:summary 必须排在 pageFooter 之后(排前面会报
         cvc-complex-type.2.4.a: 发现 pageFooter …应以 noData 之一开头) -->
  <summary>
    <band height="36">
      <staticText><reportElement style="lb8" x="0" y="0" width="60" height="18"/><text><![CDATA[检验结论]]></text></staticText>
      <textField isBlankWhenNull="true" textAdjust="StretchHeight">
        <reportElement style="l8" x="60" y="0" width="698" height="18"/>
        <textFieldExpression><![CDATA[$P{总结论}]]></textFieldExpression>
      </textField>
      <staticText><reportElement style="lb8" x="0" y="18" width="60" height="18"/><text><![CDATA[处理意见]]></text></staticText>
      <textField isBlankWhenNull="true" textAdjust="StretchHeight">
        <reportElement style="l8" x="60" y="18" width="698" height="18"/>
        <textFieldExpression><![CDATA[$P{处理方式}]]></textFieldExpression>
      </textField>
    </band>
  </summary>
</jasperReport>
