          <textFieldExpression><![CDATA[$P{头字段值}.get(14)]]></textFieldExpression>
        </textField>
      </frame>
    </band>
  </pageHeader>

  <!--
    ======================= 明细表 =======================
    运行时这里不是空的:GenericReportSupport.buildMaster() 把本文件的 <style> 段复制过来,
    并为每个「列块」拼一条 detail 带(带里一个 <subreport>,数据源 = $F{块数据})。
    明细 0 行时子报表不产出内容,detail 带整条不出现 —— 只有头字段的单据照样出图。
    单块示例(生成结果):
      <detail>
        <band height="60">
          <subreport>
            <reportElement x="0" y="20" width="768" height="20"/>
            <subreportParameter name="列标签">…</subreportParameter>
            <dataSourceExpression><![CDATA[$F{块数据}]]></dataSourceExpression>
            <subreportExpression class="…JasperReport"><![CDATA[(…JasperReport) $P{子报表}]]></subreportExpression>
          </subreport>
        </band>
      </detail>
  -->

  <!-- ======================= 页脚:打印时间 + 页码 ======================= -->
  <pageFooter>
    <band height="22">
      <textField isBlankWhenNull="true">
        <reportElement style="pager" x="0" y="4" width="420" height="14"/>
        <textFieldExpression><![CDATA["打印时间：" + $P{打印时间}]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Now">
        <reportElement style="pagerR" x="568" y="4" width="52" height="14"/>
        <textFieldExpression><![CDATA["第 " + $V{PAGE_NUMBER} + " 页"]]></textFieldExpression>
      </textField>
      <textField evaluationTime="Report">
        <reportElement style="pager" x="620" y="4" width="148" height="14"/>
        <textFieldExpression><![CDATA[" / 共 " + $V{PAGE_NUMBER} + " 页"]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>
</jasperReport>
