  | 3-view-def | 
CREATE   VIEW dbo.v_prod_pick_list
AS
SELECT o.id,
       o.[单据编号], o.[单据类型], o.[单据日期],
       o.[物料编码], o.[物料名称], o.[规格型号], o.[计量单位],
       o.[仓库编码], o.[仓库名称], o.[批号], o.[数量],
       o.[成本单价], o.[成本金额], o.[经手人],
       o.asp_user1, o.[单据日期] AS asp_time1, o.asp_user3, o.asp_time3
  FROM dbo.outh o
 WHERE o.src = 6
   AND ISNULL(o.asp_cancel, N'N') <> N'Y'; | 
