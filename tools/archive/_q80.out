SALE_OUT|退货原因|退货原因|SELECT v FROM (VALUES (N'客户退货'),(N'质量原因'),(N'其他')) AS t(v)
SO_ORDER|客户编码|客户编码|SELECT v FROM (VALUES (N'KH001'),(N'KH002'),(N'KH003'),(N'KH004'),(N'KH005')) AS t(v)
SO_ORDER|结算客户|结算客户|SELECT v FROM (VALUES (N'华东铝业'),(N'中天精工'),(N'西部材料'),(N'南方重工'),(N'北方机械')) AS t(v)
SO_ORDER|销售单位|销售单位|SELECT v FROM (VALUES (N'件'),(N'kg'),(N'套')) AS t(v)
SO_ORDER|币种|币种|SELECT 名称 FROM bs_currency WHERE ISNULL(asp_cancel,'N')<>'Y' AND ISNULL(停用,0)<>1
SO_ORDER|部门|部门|SELECT v FROM (VALUES (N'销售一部'),(N'销售二部'),(N'国际部')) AS t(v)
SO_ORDER|业务员|业务员|SELECT v FROM (VALUES (N'张伟'),(N'李娜'),(N'王芳'),(N'陈强')) AS t(v)
