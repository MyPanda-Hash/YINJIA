panel_code|col_name|label|dict_sql
PU_ORDER|单位|单位|SELECT v FROM (VALUES (N'件'),(N'kg'),(N'套'),(N'升')) AS t(v)
PU_ORDER|币种|币种|SELECT v FROM (VALUES (N'人民币')) AS t(v)
PU_ORDER|税率%|税率%|SELECT v FROM (VALUES (N'0'),(N'3'),(N'6'),(N'9'),(N'13')) AS t(v)
PURCHASE_IN|计量单位|计量单位|SELECT v FROM (VALUES (N'件'),(N'kg'),(N'套'),(N'升')) AS t(v)
PURCHASE_IN|计量单位2|计量单位2|SELECT v FROM (VALUES (N'件'),(N'kg'),(N'套'),(N'升')) AS t(v)
PURCHASE_IN|税率%|税率%|SELECT v FROM (VALUES (N'0'),(N'3'),(N'6'),(N'9'),(N'13')) AS t(v)
SALE_OUT|出库类别|出库类别|SELECT v FROM (VALUES (N'普通销售'),(N'销售退货')) AS t(v)
SALE_OUT|计量单位|计量单位|SELECT v FROM (VALUES (N'件'),(N'kg'),(N'套'),(N'升')) AS t(v)
