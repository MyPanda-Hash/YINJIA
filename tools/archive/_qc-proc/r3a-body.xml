  <!-- ======================= 制程检验组(band: title) =======================
       2026-10-15 用户口径:「格式修改为当前上面的实现模式就可以了」——按用户截图逐格实测改版:
       截图 2868x372px,按表宽 758pt 换算得各列边界(measure-bands.py 量的竖线):
         产品编码 0/29 · 型号（mm) 29/48 · 批号 77/130 · 抽检总量 207/196
         外观组 403/119(端盖两头 56 · 管身两侧 42 · 按项目填充 21)
         尺寸组 522/107(5 格) · 出货重量组 629/107(5 格) · 结果判断 736/22
       与上一版的两处差别:
         ① **去掉「检验时间」「客户名称」两列**(截图左起第一列就是产品编码);
         ② 外观由「一格拼串」改为**三格各显其值**(端盖两头/管身两侧/其余外观项)。
       列宽合计 758pt = columnWidth(与 calc.mjs 口径一致)。 -->
  <title>
    <band height="166">
      <!-- 公司 + 标题:放在 title 最上方(title 在所有 band 之前渲染) -->
      <textField>
        <reportElement style="company" x="0" y="0" width="758" height="20"/>
        <textFieldExpression><![CDATA[$P{公司名称}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement style="docTitle" x="0" y="20" width="758" height="20"/>
        <textFieldExpression><![CDATA["制程检验记录表"]]></textFieldExpression>
      </textField>
      <!-- 元信息行 -->
      <textField isBlankWhenNull="true">
        <reportElement style="meta" x="0" y="40" width="380" height="10"/>
        <textFieldExpression><![CDATA["检验类别/工序：" + ($P{检验类别} == null ? "" : $P{检验类别}) + ($P{工序} == null ? "" : " / " + $P{工序})]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="metaR" x="380" y="40" width="378" height="10"/>
        <textFieldExpression><![CDATA["编号：" + ($P{单据编号} == null ? "" : $P{单据编号}) + "    日期：" + ($P{单据日期} == null ? "" : new java.text.SimpleDateFormat("yyyy-MM-dd", java.util.Locale.CHINA).format($P{单据日期}))]]></textFieldExpression>
      </textField>

      <!-- 黄底提示(2026-10-15 措辞按截图:检查频率来自**出货检验计划**) -->
      <staticText>
        <reportElement style="notice" x="0" y="52" width="758" height="16"/>
        <text><![CDATA[以下检验项目对应出货检验计划的检查频率，1PCS/一个生产批次才进行测试]]></text>
      </staticText>

      <!-- 组标题行 y=70 高 12 -->
      <staticText><reportElement style="th7" x="403" y="70" width="119" height="12" /><text><![CDATA[外观]]></text></staticText>
      <staticText><reportElement style="th7" x="522" y="70" width="107" height="12" /><text><![CDATA[尺寸]]></text></staticText>
      <staticText><reportElement style="th7" x="629" y="70" width="107" height="12" /><text><![CDATA[出货重量]]></text></staticText>

      <!-- 固定 4 列 + 结果判断:表头跨两行(y=70..120) -->
      <staticText><reportElement style="th6" x="0" y="70" width="29" height="50" /><text><![CDATA[产品编码]]></text></staticText>
      <staticText><reportElement style="th6" x="29" y="70" width="48" height="50" /><text><![CDATA[型号（mm)]]></text></staticText>
      <staticText><reportElement style="th6" x="77" y="70" width="130" height="50" /><text><![CDATA[批号]]></text></staticText>
      <staticText><reportElement style="th6" x="207" y="70" width="196" height="50" /><text><![CDATA[抽检总量]]></text></staticText>
      <staticText><reportElement style="th6" x="736" y="70" width="22" height="50" /><text><![CDATA[结果判断]]></text></staticText>

      <!-- 外观 3 子列(y=82..120) -->
      <staticText><reportElement style="th6" x="403" y="82" width="56" height="38" /><text><![CDATA[端盖两头]]></text></staticText>
      <staticText><reportElement style="th6" x="459" y="82" width="42" height="38" /><text><![CDATA[管身两侧]]></text></staticText>
      <staticText><reportElement style="th6" x="501" y="82" width="21" height="38" /><text><![CDATA[按项目填充]]></text></staticText>

      <!-- 尺寸 / 出货重量 占位表头(y=82..120) -->
      <staticText><reportElement style="th7" x="522" y="82" width="107" height="38" /><text><![CDATA[按照尺寸检验项目填充]]></text></staticText>
      <staticText><reportElement style="th7" x="629" y="82" width="107" height="38" /><text><![CDATA[按照重量检验项目填充]]></text></staticText>

      <!-- 数据行 y=120 高 42 -->
      <textField isBlankWhenNull="true">
        <reportElement style="c6" x="0" y="120" width="29" height="42" />
        <textFieldExpression><![CDATA[$P{产品编码}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c6" x="29" y="120" width="48" height="42" />
        <textFieldExpression><![CDATA[$P{规格型号}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c6" x="77" y="120" width="130" height="42" />
        <textFieldExpression><![CDATA[$P{批次号}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="c6" x="207" y="120" width="196" height="42" />
        <textFieldExpression><![CDATA[$P{抽检总量} == null ? "" : new java.text.DecimalFormat("#,##0.###").format($P{抽检总量})]]></textFieldExpression>
      </textField>

      <!-- 外观 3 格:按明细「表区=外观」的行**逐行**取值(端盖两头/管身两侧/其余外观项) -->
      <textField isBlankWhenNull="true"><reportElement style="c6" x="403" y="120" width="56" height="42"/><textFieldExpression><![CDATA[$P{外观_1}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="459" y="120" width="42" height="42"/><textFieldExpression><![CDATA[$P{外观_2}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="501" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{外观_3}]]></textFieldExpression></textField>

      <!-- 尺寸 5 格:后端把「测量值1..5 / 实测数值按 / 拆」的多值串摊平成 5 格 -->
      <textField isBlankWhenNull="true"><reportElement style="c6" x="522" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{尺寸_1}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="543" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{尺寸_2}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="564" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{尺寸_3}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="585" y="120" width="22" height="42"/><textFieldExpression><![CDATA[$P{尺寸_4}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="607" y="120" width="22" height="42"/><textFieldExpression><![CDATA[$P{尺寸_5}]]></textFieldExpression></textField>

      <!-- 出货重量 5 格 -->
      <textField isBlankWhenNull="true"><reportElement style="c6" x="629" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{重量_1}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="650" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{重量_2}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="671" y="120" width="21" height="42"/><textFieldExpression><![CDATA[$P{重量_3}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="692" y="120" width="22" height="42"/><textFieldExpression><![CDATA[$P{重量_4}]]></textFieldExpression></textField>
      <textField isBlankWhenNull="true"><reportElement style="c6" x="714" y="120" width="22" height="42"/><textFieldExpression><![CDATA[$P{重量_5}]]></textFieldExpression></textField>

      <textField isBlankWhenNull="true">
        <reportElement style="c6" x="736" y="120" width="22" height="42" />
        <textFieldExpression><![CDATA[$P{总结论}]]></textFieldExpression>
      </textField>
    </band>
  </title>
