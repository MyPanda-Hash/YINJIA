  <pageHeader>
    <band height="118">
      <textField>
        <reportElement style="company" x="0" y="0" width="539" height="20"/>
        <textFieldExpression><![CDATA[$P{公司}]]></textFieldExpression>
      </textField>

      <textField>
        <reportElement style="docTitle" x="0" y="20" width="539" height="34"/>
        <textFieldExpression><![CDATA["出厂检验报告"]]></textFieldExpression>
      </textField>

      <textField isBlankWhenNull="true">
        <reportElement style="meta" x="0" y="56" width="200" height="16"/>
        <textFieldExpression><![CDATA["报告编号：" + ($P{单据编号} == null ? "" : $P{单据编号})]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="meta" x="200" y="56" width="190" height="16"/>
        <textFieldExpression><![CDATA["编制日期：" + ($P{单据日期} == null ? "" : String.valueOf($P{单据日期}).substring(0, Math.min(10, String.valueOf($P{单据日期}).length())))]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="metaR" x="390" y="56" width="149" height="16"/>
        <textFieldExpression><![CDATA["客户：" + ($P{客户} == null ? "" : $P{客户})]]></textFieldExpression>
      </textField>

      <frame>
        <reportElement x="0" y="76" width="539" height="38"/>
        <box><pen lineWidth="0.5" lineColor="#8A8A8A"/></box>

        <staticText><reportElement style="gridLabel" x="4" y="0" width="62" height="19"/><text><![CDATA[产品名称：]]></text></staticText>
        <textField isBlankWhenNull="true"><reportElement style="gridValue" x="66" y="0" width="112" height="19"/><textFieldExpression><![CDATA[$F{存货名称}]]></textFieldExpression></textField>
        <staticText><reportElement style="gridLabel" x="182" y="0" width="62" height="19"/><text><![CDATA[产品规格：]]></text></staticText>
        <textField isBlankWhenNull="true"><reportElement style="gridValue" x="244" y="0" width="112" height="19"/><textFieldExpression><![CDATA[$F{规格型号}]]></textFieldExpression></textField>
        <staticText><reportElement style="gridLabel" x="360" y="0" width="62" height="19"/><text><![CDATA[产品编码：]]></text></staticText>
        <textField isBlankWhenNull="true"><reportElement style="gridValue" x="422" y="0" width="113" height="19"/><textFieldExpression><![CDATA[$F{存货编码}]]></textFieldExpression></textField>

        <staticText><reportElement style="gridLabel" x="4" y="19" width="62" height="19"/><text><![CDATA[生产日期：]]></text></staticText>
        <textField isBlankWhenNull="true"><reportElement style="gridValue" x="66" y="19" width="112" height="19"/><textFieldExpression><![CDATA[$P{单据日期} == null ? "" : String.valueOf($P{单据日期}).substring(0, Math.min(10, String.valueOf($P{单据日期}).length()))]]></textFieldExpression></textField>
        <staticText><reportElement style="gridLabel" x="182" y="19" width="62" height="19"/><text><![CDATA[生产数量：]]></text></staticText>
        <textField isBlankWhenNull="true" pattern="#,##0.###"><reportElement style="gridValue" x="244" y="19" width="112" height="19"/><textFieldExpression><![CDATA[$F{数量}]]></textFieldExpression></textField>
        <staticText><reportElement style="gridLabel" x="360" y="19" width="62" height="19"/><text><![CDATA[检测日期：]]></text></staticText>
        <textField isBlankWhenNull="true"><reportElement style="gridValue" x="422" y="19" width="113" height="19"/><textFieldExpression><![CDATA[$P{打印时间}]]></textFieldExpression></textField>
      </frame>
    </band>
  </pageHeader>
